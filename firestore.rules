rules_version = '2';

// =============================================================================
// Nexus ITAM - Regras de Seguranca Multi-Tenant
// -----------------------------------------------------------------------------
// Principios:
//  1. FECHADO POR PADRAO. Nao existe regra "catch-all" permissiva. Toda colecao
//     precisa ser declarada explicitamente aqui para ser acessivel.
//  2. O tenant do usuario vem PRIMEIRO do custom claim (request.auth.token.tenantId)
//     e so cai para o documento /users/{uid} como fallback de migracao.
//  3. Um usuario NUNCA pode alterar o proprio `role`, `tenantId` ou `status`.
//     Escalonamento de privilegio e bloqueado na origem.
//  4. Ninguem se vincula a uma empresa sozinho: o perfil so nasce (a) junto com
//     a empresa que o proprio usuario esta fundando, ou (b) consumindo um
//     convite pendente enderecado ao e-mail dele. Antes, qualquer conta nova
//     podia gravar /users/{uid} com o tenantId de outra empresa e role 'owner'.
//  5. Empresa suspensa/encerrada e usuario suspenso perdem acesso aos dados
//     operacionais. Antes o status era so visual: o acesso continuava.
//  6. Segredos (agentToken) vivem em /tenantSecrets/{tenantId}, legivel apenas
//     por owner/admin do proprio tenant - nunca pelo tenant vizinho nem pelo master.
//  7. LGPD: o Nexus e OPERADOR dos dados que o Agente ITAM coleta nas maquinas
//     do cliente (usuario logado, processos, tela, saida de comandos). Esses
//     dados sao da empresa cliente (controladora): o master NAO le nem comanda
//     maquinas de clientes. Suporte do Nexus entra como membro convidado pela
//     propria empresa, com papel e prazo que ela decide (ver /agent* abaixo).
//  8. Maquinas (NexusAgent.exe) usam login anonimo do Firebase vinculado a UMA
//     maquina de UMA empresa por /agentEnrollments/{uid}. Conta anonima nunca
//     conta como usuario: signedIn() a exclui.
//
// Espelhos no cliente: src/utils/permissions.js (papeis e capacidades) e
// src/utils/entitlements.js (status que bloqueiam acesso).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------------------

    // Login anonimo e exclusivo do agente instalado nas maquinas.
    function isAgent() {
      return request.auth != null &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    // Pessoa autenticada (nunca o agente).
    function signedIn() {
      return request.auth != null && !isAgent();
    }

    function claims() {
      return request.auth.token;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profileExists() {
      return exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function tenantPath(t) {
      return /databases/$(database)/documents/tenants/$(t);
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/invites/$(inviteId);
    }

    // Tenant efetivo: custom claim > documento de perfil > null (sem acesso)
    function tenantOf() {
      return !signedIn()
        ? null
        : ('tenantId' in claims()
            ? claims().tenantId
            : (profileExists() ? profile().tenantId : null));
    }

    // Papel efetivo: custom claim > documento de perfil > 'viewer' (menor privilegio)
    function roleOf() {
      return !signedIn()
        ? 'anonymous'
        : ('role' in claims()
            ? claims().role
            : (profileExists() ? profile().role : 'viewer'));
    }

    function isMaster() {
      return signedIn() && tenantOf() == 'nexus-master' && roleOf() == 'superadmin';
    }

    function hasAuthEmail() {
      return ('email' in request.auth.token) && request.auth.token.email is string;
    }

    function authEmail() {
      return hasAuthEmail() ? request.auth.token.email.lower() : '';
    }

    // Usuario suspenso pelo owner/admin ou pelo master. Continua lendo o
    // proprio perfil (a UI precisa explicar o bloqueio), mas nada alem disso.
    function memberBlocked() {
      return profileExists() &&
        profile().get('status', 'active') in ['suspended', 'blocked', 'disabled'];
    }

    // Empresa suspensa ou encerrada pelo master. Empresa sem cadastro em
    // /tenants (legada, anterior ao modulo SaaS) nao e bloqueada.
    function tenantBlocked(t) {
      return exists(tenantPath(t)) &&
        get(tenantPath(t)).data.get('status', 'active') in ['suspended', 'cancelled'];
    }

    // Pertence ao mesmo tenant do recurso, com acesso ativo (tenant nulo nunca casa)
    function sameTenant(t) {
      return signedIn() && t != null && t is string && t == tenantOf() &&
        !memberBlocked() && !tenantBlocked(t);
    }

    function isTenantOwner(t) {
      return sameTenant(t) && roleOf() == 'owner';
    }

    function isTenantAdmin(t) {
      return sameTenant(t) && roleOf() in ['owner', 'admin'];
    }

    // Gestao: exclusao de ativos e leitura da caixa do agente
    function canManage(t) {
      return sameTenant(t) && roleOf() in ['owner', 'admin', 'manager'];
    }

    // Papeis autorizados a gravar dados de membro (equipe, projetos, licencas, setores)
    function canMember(t) {
      return sameTenant(t) && roleOf() in ['owner', 'admin', 'manager', 'member'];
    }

    // Papeis autorizados a gravar dados operacionais do tenant
    function canOperate(t) {
      return sameTenant(t) && roleOf() in ['owner', 'admin', 'manager', 'member', 'operator'];
    }

    function validRole(r) {
      return r in ['owner', 'admin', 'manager', 'member', 'operator', 'viewer'];
    }

    // Papel que o usuario logado (owner ou admin) pode conceder ou revogar.
    // Admin nunca cria/altera owner nem outro admin. Espelha assignableRoles().
    function canAssignRole(r) {
      return validRole(r) && (roleOf() == 'owner' || r in ['manager', 'member', 'operator', 'viewer']);
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // --- Atalhos para colecoes de negocio escopadas por tenantId ---

    function tenantRead() {
      return isMaster() || sameTenant(resource.data.tenantId);
    }

    function tenantCreate() {
      return isMaster() || canOperate(request.resource.data.tenantId);
    }

    // Update nao pode "sequestrar" o documento para outro tenant
    function tenantUpdate() {
      return isMaster() || (
        canOperate(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      );
    }

    function tenantDelete() {
      return isMaster() || canOperate(resource.data.tenantId);
    }

    function memberCreate() {
      return isMaster() || canMember(request.resource.data.tenantId);
    }

    function memberUpdate() {
      return isMaster() || (
        canMember(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      );
    }

    function memberDelete() {
      return isMaster() || canMember(resource.data.tenantId);
    }

    function managerCreate() {
      return isMaster() || canManage(request.resource.data.tenantId);
    }

    function managerUpdate() {
      return isMaster() || (
        canManage(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      );
    }

    function managerDelete() {
      return isMaster() || canManage(resource.data.tenantId);
    }

    // --- Entrada de um novo membro ---

    // (a) Fundador: o perfil de owner nasce no MESMO batch que cria a empresa,
    //     e a empresa aponta para este UID como dono.
    function foundsTenant(data) {
      return data.role == 'owner' &&
        !exists(tenantPath(data.tenantId)) &&
        getAfter(tenantPath(data.tenantId)).data.ownerUid == request.auth.uid;
    }

    function inviteMatches(data, invite) {
      return invite.status == 'pending' &&
        invite.tenantId == data.tenantId &&
        invite.role == data.role &&
        authEmail() != '' &&
        invite.email == authEmail() &&
        (invite.get('expiresAt', null) == null || invite.expiresAt > request.time) &&
        getAfter(invitePath(data.inviteId)).data.status == 'accepted';
    }

    // (b) Convidado: consome, no mesmo batch, um convite pendente enderecado
    //     ao e-mail autenticado, herdando exatamente tenant e papel do convite.
    function acceptsInvite(data) {
      return data.get('inviteId', null) is string &&
        exists(invitePath(data.inviteId)) &&
        inviteMatches(data, get(invitePath(data.inviteId)).data);
    }

    // ---------------------------------------------------------------------
    // USUARIOS
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isMaster() ||
        sameTenant(resource.data.tenantId)
      );

      allow create: if isMaster() || (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId != 'nexus-master' &&
        validRole(request.resource.data.role) &&
        request.resource.data.get('status', 'active') == 'active' &&
        (foundsTenant(request.resource.data) || acceptsInvite(request.resource.data))
      );

      allow update: if isMaster()
        // O proprio usuario edita o perfil (se nao bloqueado), apenas campos permitidos
        || (
          signedIn() &&
          request.auth.uid == userId &&
          !memberBlocked() &&
          !tenantBlocked(resource.data.tenantId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'photoURL', 'theme', 'accentColor', 'lastLoginAt', 'updatedAt', 'email', 'phone'
          ])
        )
        // Owner/admin gerencia OUTROS membros do proprio tenant, sem trocar o
        // tenant e sem ultrapassar o proprio nivel (admin nao toca em owner/admin).
        || (
          isTenantAdmin(resource.data.tenantId) &&
          request.auth.uid != userId &&
          request.resource.data.tenantId == resource.data.tenantId &&
          canAssignRole(resource.data.role) &&
          canAssignRole(request.resource.data.role) &&
          request.resource.data.get('status', 'active') in ['active', 'suspended']
        );

      allow delete: if isMaster() || (
        isTenantAdmin(resource.data.tenantId) &&
        request.auth.uid != userId &&
        canAssignRole(resource.data.role)
      );
    }

    // ---------------------------------------------------------------------
    // TENANTS (empresas)
    // ---------------------------------------------------------------------
    match /tenants/{tenantId} {
      // Sem listagem global: cada empresa so enxerga a si mesma.
      allow read: if isMaster() || (signedIn() && tenantId == tenantOf());

      // Self-service signup: so quem ainda nao pertence a empresa nenhuma, sempre
      // no plano de entrada, sem limites/ajustes (esses sao comerciais: so o master).
      allow create: if isMaster() || (
        signedIn() &&
        !profileExists() &&
        tenantId != 'nexus-master' &&
        request.resource.data.keys().hasOnly(['id', 'companyName', 'ownerUid', 'plan', 'status', 'createdAt', 'updatedAt']) &&
        request.resource.data.id == tenantId &&
        request.resource.data.companyName is string &&
        request.resource.data.companyName.size() > 0 &&
        request.resource.data.companyName.size() <= 120 &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.plan == 'starter' &&
        request.resource.data.status == 'active'
      );

      // O owner so renomeia a empresa. Plano, status, limites e ajustes: master.
      allow update: if isMaster() || (
        isTenantOwner(tenantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'updatedAt'])
      );

      allow delete: if isMaster();
    }

    // Anotacoes comerciais internas do master sobre cada empresa (contato,
    // negociacao, observacoes). Nunca visiveis para o proprio cliente.
    match /tenantInternal/{tenantId} {
      allow read, write: if isMaster();
    }

    // ---------------------------------------------------------------------
    // PLANOS COMERCIAIS
    // ---------------------------------------------------------------------
    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isMaster();
    }

    // ---------------------------------------------------------------------
    // CONFIGURACOES / WHITELABEL (nao-secreto)
    // ---------------------------------------------------------------------

    // Admin grava apenas as chaves do Agente ITAM. `agentToken` so pode ser
    // REMOVIDO daqui (migracao para /tenantSecrets), nunca gravado.
    function agentSettingsOnly() {
      let allowed = ['agentNaming', 'trustedIps', 'autoAcceptEnabled', 'agentPolicy', 'agentToken'];
      let affected = resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(allowed) &&
        (!affected.hasAny(['agentToken']) || !('agentToken' in request.resource.data));
    }

    match /settings/{tenantId} {
      allow read: if isMaster() || (signedIn() && tenantId == tenantOf());
      allow create, update: if isMaster() || isTenantOwner(tenantId) || (
        isTenantAdmin(tenantId) && agentSettingsOnly()
      );
      allow delete: if isMaster();
    }

    // ---------------------------------------------------------------------
    // SEGREDOS DO TENANT (agentToken, webhooks, integracoes)
    // Nunca legivel por outro tenant nem pelo master. As regras do agente leem
    // este documento server-side via get(), sem expor o valor ao cliente.
    // ---------------------------------------------------------------------
    match /tenantSecrets/{tenantId} {
      allow read, write: if isTenantAdmin(tenantId);
    }

    // ---------------------------------------------------------------------
    // CONVITES
    // O link de convite carrega o ID do documento. O convidado so le o convite
    // depois de autenticar com o e-mail convidado, e so pode marca-lo como
    // aceito — no mesmo batch em que cria o proprio perfil.
    // ---------------------------------------------------------------------
    match /invites/{inviteId} {
      function isInvitee() {
        return signedIn() && authEmail() != '' && resource.data.email == authEmail();
      }

      allow get: if isMaster() || isTenantAdmin(resource.data.tenantId) || isInvitee();
      allow list: if isMaster() || isTenantAdmin(resource.data.tenantId);

      allow create: if isMaster() || (
        isTenantAdmin(request.resource.data.tenantId) &&
        canAssignRole(request.resource.data.role) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.email is string &&
        request.resource.data.email == request.resource.data.email.lower()
      );

      allow update: if isMaster()
        || (
          isTenantAdmin(resource.data.tenantId) &&
          request.resource.data.tenantId == resource.data.tenantId &&
          canAssignRole(request.resource.data.role)
        )
        || (
          isInvitee() &&
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedBy']) &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedBy == request.auth.uid
        );

      allow delete: if isMaster() || isTenantAdmin(resource.data.tenantId);
    }

    // ---------------------------------------------------------------------
    // AGENTE ITAM
    // Tudo que o agente coleta pertence a empresa cliente (controladora, LGPD):
    // so a gestao dela le e comanda. O master nao tem acesso (ver principio 7).
    //
    // Identidade da maquina:
    //  - NexusAgent.exe (3.1+): login anonimo + matricula em /agentEnrollments
    //    feita UMA vez com prova do token da empresa (sha256(token:uid)). Depois
    //    disso o token nao viaja mais nem fica em documento ou disco.
    //  - Scripts de coleta (PowerShell/Linux/macOS, sem login): token da empresa
    //    no documento da caixa de entrada, apagado no processamento.
    // A chave da maquina nao tem "_": {tenantId}_{deviceKey} nunca cai no
    // espaco de IDs de outra empresa (ex.: "acme" + "corp_1" = "acme_corp_1").
    // ---------------------------------------------------------------------

    function validDeviceKey(k) {
      return k is string && k.matches('^[A-Za-z0-9-]{3,64}$');
    }

    function secretPath(t) {
      return /databases/$(database)/documents/tenantSecrets/$(t);
    }

    function tokenValid(t, token) {
      return t is string && token is string && token.size() > 0 &&
        exists(secretPath(t)) && get(secretPath(t)).data.get('agentToken', '') == token;
    }

    function enrollmentPath() {
      return /databases/$(database)/documents/agentEnrollments/$(request.auth.uid);
    }

    // Maquina matriculada na empresa t (e ativa).
    function agentInTenant(t) {
      return isAgent() && exists(enrollmentPath()) &&
        get(enrollmentPath()).data.tenantId == t && !tenantBlocked(t);
    }

    // Exatamente a maquina k da empresa t.
    function agentOwns(t, k) {
      return agentInTenant(t) && get(enrollmentPath()).data.deviceKey == k;
    }

    function policyPath(t) {
      return /databases/$(database)/documents/agentPolicies/$(t);
    }

    // Sem politica gravada: acesso remoto so com consentimento do colaborador.
    function policyOf(t) {
      return exists(policyPath(t))
        ? get(policyPath(t)).data
        : { 'remoteAccess': 'consent', 'commandsEnabled': true };
    }

    function auditPath(id) {
      return /databases/$(database)/documents/agentAudit/$(id);
    }

    // A acao remota so vale se, no MESMO batch, nasceu o registro de auditoria
    // com este ID, desta maquina, por quem envia (at == request.time so na criacao).
    function auditedNow(id, k) {
      return id is string && id.size() > 0 && existsAfter(auditPath(id)) &&
        getAfter(auditPath(id)).data.at == request.time &&
        getAfter(auditPath(id)).data.byUid == request.auth.uid &&
        getAfter(auditPath(id)).data.deviceKey == k;
    }

    // Matricula da maquina. Revogar = apagar (admin da empresa ou o proprio
    // agente ao desinstalar): a maquina perde o acesso na hora.
    match /agentEnrollments/{uid} {
      function proofValid(t) {
        return exists(secretPath(t)) &&
          get(secretPath(t)).data.get('agentToken', '') is string &&
          get(secretPath(t)).data.get('agentToken', '').size() > 0 &&
          hashing.sha256(get(secretPath(t)).data.agentToken + ':' + uid).toHexString().lower() == request.resource.data.tokenProof;
      }

      allow create: if isAgent() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['tenantId', 'deviceKey', 'tokenProof', 'hostname', 'agentVersion', 'createdAt']) &&
        request.resource.data.tenantId is string &&
        validDeviceKey(request.resource.data.deviceKey) &&
        request.resource.data.tokenProof is string &&
        request.resource.data.get('hostname', '') is string &&
        request.resource.data.get('hostname', '').size() <= 255 &&
        request.resource.data.createdAt is timestamp &&
        !tenantBlocked(request.resource.data.tenantId) &&
        proofValid(request.resource.data.tenantId);
      allow get: if (isAgent() && request.auth.uid == uid) ||
        (resource != null && isTenantAdmin(resource.data.tenantId));
      allow list: if isTenantAdmin(resource.data.tenantId);
      allow update: if false;
      allow delete: if (isAgent() && request.auth.uid == uid) || isTenantAdmin(resource.data.tenantId);
    }

    // Politica de execucao lida pelas maquinas: acesso remoto (desligado,
    // com consentimento, sem supervisao), comandos remotos e intervalo do sinal.
    match /agentPolicies/{tenantId} {
      allow get: if canManage(tenantId) || agentInTenant(tenantId);
      allow create, update: if isTenantAdmin(tenantId) &&
        request.resource.data.keys().hasOnly(['remoteAccess', 'commandsEnabled', 'heartbeatSeconds', 'updatedAt', 'updatedBy', 'updatedByUid']) &&
        request.resource.data.remoteAccess in ['disabled', 'consent', 'unattended'] &&
        request.resource.data.commandsEnabled is bool &&
        request.resource.data.heartbeatSeconds is int &&
        request.resource.data.heartbeatSeconds >= 30 &&
        request.resource.data.heartbeatSeconds <= 900 &&
        request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    // Trilha de quem acessou ou comandou cada maquina. Imutavel, data do
    // servidor, autor = quem esta logado. Leitura: owner/admin da empresa.
    match /agentAudit/{entryId} {
      allow read: if isTenantAdmin(resource.data.tenantId);
      allow create: if canManage(request.resource.data.tenantId) &&
        request.resource.data.keys().hasOnly(['tenantId', 'deviceKey', 'hostname', 'action', 'detail', 'mode', 'byUid', 'byName', 'at']) &&
        validDeviceKey(request.resource.data.deviceKey) &&
        request.resource.data.action in ['remote_request', 'remote_end', 'command', 'revoke'] &&
        request.resource.data.byUid == request.auth.uid &&
        request.resource.data.at == request.time &&
        request.resource.data.get('detail', '') is string &&
        request.resource.data.get('detail', '').size() <= 500;
      allow update, delete: if false;
    }

    // Caixa de entrada do inventario. Um documento por maquina
    // ({tenantId}_{deviceKey}), regravado a cada coleta; os scripts 1.x criam
    // documentos novos. Formato fechado.
    match /agentInbox/{docId} {
      function agentFields() {
        return ['tenantId', 'agentToken', 'deviceKey', 'status', 'source', 'agentVersion', 'hostname',
          'serialNumber', 'deviceId', 'internalId', 'ip_address', 'createdAt', 'payload'];
      }

      function inboxFormat(d) {
        return d.keys().hasOnly(agentFields()) &&
          d.tenantId is string &&
          d.status == 'pending' &&
          d.payload is map &&
          d.get('hostname', '') is string && d.get('hostname', '').size() <= 255;
      }

      function machineDoc(d) {
        return validDeviceKey(d.deviceKey) && docId == d.tenantId + '_' + d.deviceKey && d.createdAt is timestamp;
      }

      // Scripts sem login: token da empresa no documento.
      function scriptSubmission() {
        let d = request.resource.data;
        return inboxFormat(d) &&
          tokenValid(d.tenantId, d.agentToken) &&
          !tenantBlocked(d.tenantId) &&
          (!('deviceKey' in d) || machineDoc(d));
      }

      // NexusAgent.exe matriculado: sem token no documento.
      function enrolledSubmission() {
        let d = request.resource.data;
        return inboxFormat(d) &&
          !('agentToken' in d) &&
          'deviceKey' in d && machineDoc(d) &&
          agentOwns(d.tenantId, d.deviceKey);
      }

      allow read: if canManage(resource.data.tenantId);
      allow create: if canOperate(request.resource.data.tenantId) || scriptSubmission() || enrolledSubmission();
      allow update: if (isTenantAdmin(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId)
        || ((scriptSubmission() || enrolledSubmission()) &&
            'deviceKey' in request.resource.data &&
            resource.data.tenantId == request.resource.data.tenantId);
      allow delete: if isTenantAdmin(resource.data.tenantId);
    }

    // Inventario completo de cada maquina (programas, discos, rede, seguranca),
    // separado do ativo para a lista de ativos continuar leve.
    match /assetInventory/{assetId} {
      allow read: if sameTenant(resource.data.tenantId);
      allow create: if canOperate(request.resource.data.tenantId) && request.resource.data.assetId == assetId;
      allow update: if canOperate(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.assetId == assetId;
      allow delete: if canManage(resource.data.tenantId);
    }

    // ---------------------------------------------------------------------
    // RMM e ACESSO REMOTO (NexusAgent.exe) - canal sem colisao de escrita:
    //  - /agentDevices/{tenantId}_{deviceKey}: o agente grava telemetria, frame
    //    de tela (so durante a sessao), resultado de comando e chamado. O
    //    console grava apenas consoleWakeAt ("acorda" a maquina, que le o campo
    //    na resposta do proprio sinal de vida) e o status do chamado.
    //  - /agentControl/{tenantId}_{deviceKey}: o console grava comandos e a
    //    sessao remota; so a propria maquina le. Cada comando e cada sessao
    //    nova exigem o registro em /agentAudit no mesmo batch.
    // ---------------------------------------------------------------------
    match /agentDevices/{docId} {
      function agentDeviceFields() {
        return [
          'tenantId', 'deviceKey', 'accessId', 'hostname', 'serialNumber', 'deviceId', 'internalId',
          'assetId', 'ipAddress', 'macAddress', 'osCaption', 'loggedUser', 'agentVersion', 'status',
          'lastSeenAt', 'updatedAt', 'heartbeatSeconds', 'capabilities', 'metrics', 'topProcesses',
          'remoteState', 'screenFrame', 'lastCommandResult', 'supportRequest', 'consoleWakeAt'
        ];
      }

      function agentDeviceWrite() {
        let d = request.resource.data;
        return d.keys().hasOnly(agentDeviceFields()) &&
          validDeviceKey(d.deviceKey) &&
          docId == d.tenantId + '_' + d.deviceKey &&
          agentOwns(d.tenantId, d.deviceKey);
      }

      allow read: if canManage(resource.data.tenantId);
      allow create: if agentDeviceWrite();
      allow update: if (
          canManage(resource.data.tenantId) &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.deviceKey == resource.data.deviceKey
        ) || (agentDeviceWrite() && resource.data.tenantId == request.resource.data.tenantId);
      allow delete: if canManage(resource.data.tenantId);
    }

    match /agentControl/{docId} {
      function controlFields() {
        return ['tenantId', 'deviceKey', 'updatedAt', 'remoteSession', 'pendingCommand', 'viewerSeenAt'];
      }

      function previous() {
        return resource == null ? {} : resource.data;
      }

      // Comando novo: assinado por quem envia, hora do servidor, auditado e
      // permitido pela politica da empresa.
      function commandOk(d) {
        return d.get('pendingCommand', null) == previous().get('pendingCommand', null) || (
          d.pendingCommand is map &&
          d.pendingCommand.get('requestedByUid', '') == request.auth.uid &&
          d.pendingCommand.get('issuedAt', null) == request.time &&
          policyOf(d.tenantId).get('commandsEnabled', true) == true &&
          auditedNow(d.pendingCommand.get('id', ''), d.deviceKey)
        );
      }

      // Encerrar sempre pode. Abrir/usar: politica permite, autor = quem esta
      // logado, "sem consentimento" so se a empresa liberou, e sessao nova auditada.
      function sessionOk(d) {
        let s = d.get('remoteSession', null);
        let before = previous().get('remoteSession', {});
        return s == previous().get('remoteSession', null) || (
          s is map && (
            s.get('status', 'closed') in ['closed', 'ended'] || (
              policyOf(d.tenantId).get('remoteAccess', 'consent') != 'disabled' &&
              s.get('requestedByUid', '') == request.auth.uid &&
              (s.get('mode', 'attended') == 'attended' || policyOf(d.tenantId).get('remoteAccess', 'consent') == 'unattended') &&
              (s.get('sessionId', '') == before.get('sessionId', '') || auditedNow(s.get('sessionId', ''), d.deviceKey))
            )
          )
        );
      }

      function controlWrite() {
        let d = request.resource.data;
        return d.keys().hasOnly(controlFields()) &&
          validDeviceKey(d.deviceKey) &&
          docId == d.tenantId + '_' + d.deviceKey &&
          commandOk(d) &&
          sessionOk(d);
      }

      allow get: if resource == null
        ? isAgent()
        : (canManage(resource.data.tenantId) || agentOwns(resource.data.tenantId, resource.data.deviceKey));
      allow list: if canManage(resource.data.tenantId);
      allow create: if canManage(request.resource.data.tenantId) && controlWrite();
      allow update: if canManage(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.deviceKey == resource.data.deviceKey &&
        controlWrite();
      allow delete: if canManage(resource.data.tenantId);
    }

    // ---------------------------------------------------------------------
    // COLECOES OPERACIONAIS ESCOPADAS POR TENANT
    // ---------------------------------------------------------------------
    // Excluir ativo apaga o registro patrimonial: exige gestor ('assets:delete').
    match /assets/{docId}        { allow read: if tenantRead(); allow create: if tenantCreate(); allow update: if tenantUpdate(); allow delete: if managerDelete(); }
    match /employees/{docId}     { allow read: if tenantRead(); allow create: if memberCreate(); allow update: if memberUpdate(); allow delete: if memberDelete(); }
    match /sectors/{docId}       { allow read: if tenantRead(); allow create: if memberCreate(); allow update: if memberUpdate(); allow delete: if memberDelete(); }
    match /locations/{docId}     { allow read: if tenantRead(); allow create: if isMaster() || isTenantAdmin(request.resource.data.tenantId); allow update: if isMaster() || (isTenantAdmin(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId); allow delete: if isMaster() || isTenantAdmin(resource.data.tenantId); }
    match /projects/{docId}      { allow read: if tenantRead(); allow create: if memberCreate(); allow update: if memberUpdate(); allow delete: if memberDelete(); }
    match /tasks/{docId}         { allow read: if tenantRead(); allow create: if tenantCreate(); allow update: if tenantUpdate(); allow delete: if tenantDelete(); }
    match /licenses/{docId}      { allow read: if tenantRead(); allow create: if memberCreate(); allow update: if memberUpdate(); allow delete: if memberDelete(); }
    match /contracts/{docId}     { allow read: if tenantRead(); allow create: if managerCreate(); allow update: if managerUpdate(); allow delete: if managerDelete(); }
    match /serviceOrders/{docId} { allow read: if tenantRead(); allow create: if managerCreate(); allow update: if managerUpdate(); allow delete: if managerDelete(); }
    // Relatorio de auditoria patrimonial: imutavel depois de salvo (so o master
    // corrige), com a data do servidor (o owner grava data antiga ao restaurar
    // backup). Excluir exige gestor.
    match /audits/{docId} {
      allow read: if tenantRead();
      allow create: if tenantCreate() && (
        request.resource.data.get('date', null) == request.time ||
        isMaster() ||
        isTenantOwner(request.resource.data.tenantId)
      );
      allow update: if isMaster();
      allow delete: if managerDelete();
    }

    // Trilha de auditoria: append-only. Ninguem reescreve o passado, exceto o
    // master — nem registra com data retroativa: a data e a do servidor. So o
    // owner grava data antiga, ao restaurar um backup.
    match /history/{docId} {
      allow read: if tenantRead();
      allow create: if tenantCreate() && (
        request.resource.data.get('date', null) == request.time ||
        isMaster() ||
        isTenantOwner(request.resource.data.tenantId)
      );
      allow update, delete: if isMaster();
    }

    // ---------------------------------------------------------------------
    // TERMOS (responsabilidade, devolucao, transferencia e recebimento)
    // O documento assinado nao muda: numero, tipo, itens e emissao sao fixos.
    // Depois de emitido, so evolui o status (assinatura, recebimento na loja).
    // Cancelar ou excluir exige gestor.
    // ---------------------------------------------------------------------
    match /terms/{termId} {
      allow read: if tenantRead();

      allow create: if tenantCreate() &&
        request.resource.data.kind in ['responsabilidade', 'devolucao', 'transferencia'] &&
        request.resource.data.number is string &&
        request.resource.data.assets is list &&
        request.resource.data.assets.size() > 0 &&
        request.resource.data.assets.size() <= 150;

      // Concluir (assinado/recebido) exige o termo assinado anexado; so gestor
      // conclui sem o papel. O anexo, uma vez gravado, so o gestor substitui.
      function concludesWithoutCopy() {
        return request.resource.data.status != resource.data.status &&
          request.resource.data.status in ['assinado', 'recebido', 'recebido_ressalvas'] &&
          request.resource.data.get('signedCopy', null) == null;
      }

      allow update: if isMaster() || (
        canOperate(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        !changed(['kind', 'number', 'year', 'sequence', 'assets', 'assetIds', 'issuedAt', 'issuedBy', 'issuedByName']) &&
        (request.resource.data.status != 'cancelado' || canManage(resource.data.tenantId)) &&
        (!concludesWithoutCopy() || canManage(resource.data.tenantId)) &&
        (resource.data.get('signedCopy', null) == null || !changed(['signedCopy']) || canManage(resource.data.tenantId))
      );

      allow delete: if isMaster() || canManage(resource.data.tenantId);
    }

    // Arquivo do termo assinado, em pedacos de ate ~1 MB (sem Cloud Storage no
    // plano Spark). Gravado junto com a conclusao do termo; nunca e editado.
    match /termFiles/{fileId} {
      allow get: if tenantRead();

      allow create: if tenantCreate() &&
        request.resource.data.keys().hasOnly(['tenantId', 'termId', 'fileId', 'index', 'total', 'name', 'contentType', 'size', 'data', 'createdAt', 'createdBy']) &&
        request.resource.data.data is bytes &&
        request.resource.data.data.size() <= 950000 &&
        request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 6 &&
        request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < request.resource.data.total &&
        request.resource.data.size is int && request.resource.data.size <= 5242880 &&
        request.resource.data.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'] &&
        fileId == request.resource.data.fileId + '_' + string(request.resource.data.index) &&
        get(/databases/$(database)/documents/terms/$(request.resource.data.termId)).data.tenantId == request.resource.data.tenantId;

      allow update: if false;
      allow delete: if isMaster() || canManage(resource.data.tenantId);
    }

    // Numeracao sequencial por empresa e ano (TR-2026-0001). Cada contador so
    // avanca de 1 em 1, dentro da mesma transacao que emite o termo.
    match /termCounters/{tenantId}/years/{year} {
      function counterKeys() {
        return ['responsabilidade', 'devolucao', 'transferencia', 'updatedAt'];
      }

      function bumpedAtMostOne(key) {
        return request.resource.data.get(key, 0) == resource.data.get(key, 0) ||
          request.resource.data.get(key, 0) == resource.data.get(key, 0) + 1;
      }

      allow get: if isMaster() || sameTenant(tenantId);

      allow create: if isMaster() || (
        canOperate(tenantId) &&
        request.resource.data.keys().hasOnly(counterKeys()) &&
        request.resource.data.get('responsabilidade', 0) is int &&
        request.resource.data.get('responsabilidade', 0) >= 0 &&
        request.resource.data.get('responsabilidade', 0) <= 1 &&
        request.resource.data.get('devolucao', 0) is int &&
        request.resource.data.get('devolucao', 0) >= 0 &&
        request.resource.data.get('devolucao', 0) <= 1 &&
        request.resource.data.get('transferencia', 0) is int &&
        request.resource.data.get('transferencia', 0) >= 0 &&
        request.resource.data.get('transferencia', 0) <= 1
      );

      allow update: if isMaster() || (
        canOperate(tenantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(counterKeys()) &&
        request.resource.data.get('responsabilidade', 0) is int &&
        request.resource.data.get('responsabilidade', 0) >= 0 &&
        request.resource.data.get('devolucao', 0) is int &&
        request.resource.data.get('devolucao', 0) >= 0 &&
        request.resource.data.get('transferencia', 0) is int &&
        request.resource.data.get('transferencia', 0) >= 0 &&
        bumpedAtMostOne('responsabilidade') &&
        bumpedAtMostOne('devolucao') &&
        bumpedAtMostOne('transferencia')
      );
    }

    // ---------------------------------------------------------------------
    // COLLECTION GROUP (visao global do Nexus Master)
    // ---------------------------------------------------------------------
    match /{path=**}/assets/{assetId}       { allow read: if isMaster(); }
    match /{path=**}/employees/{employeeId} { allow read: if isMaster(); }
    match /{path=**}/sectors/{sectorId}     { allow read: if isMaster(); }
    match /{path=**}/projects/{projectId}   { allow read: if isMaster(); }
    match /{path=**}/history/{historyId}    { allow read: if isMaster(); }

    // Tudo que nao foi declarado acima permanece negado.
  }
}
