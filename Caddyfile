# =============================================================================
# Nexus ITAM v3.0 — Caddy Reverse Proxy (Auto HTTPS TLS 1.3 + HTTP/3 + WSS)
# =============================================================================
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Edge API Gateway (REST APIs 1..4 + WebSocket API 5 em wss://)
{$API_DOMAIN} {
	import security_headers
	encode zstd gzip

	reverse_proxy api-gateway:8000 {
		header_up X-Real-IP {remote_host}
	}
}

# Frontend 1: Console Administrativo ITAM (React 19)
{$CONSOLE_DOMAIN} {
	import security_headers
	encode zstd gzip

	reverse_proxy console-react:8080
}

# Frontend 2: Portal Self-Service do Colaborador (Vue 3.5)
{$PORTAL_DOMAIN} {
	import security_headers
	encode zstd gzip

	reverse_proxy portal-vue:8080
}
