# =============================================================================
# Nexus ITAM v3.0 — Template de Variáveis de Produção para VPS (.env.vps)
# =============================================================================
# Copie para `.env.vps` na sua VPS (ou execute `bash scripts/deploy-vps.sh`
# para gerar automaticamente os segredos de 256 bits com OpenSSL).
# =============================================================================

# Impede que o Docker exponha portas internas (3000/3001/8000) em 0.0.0.0,
# garantindo que todo tráfego público passe exclusivamente pelo Caddy (TLS 443)
EXPOSE_HOST_IP=127.0.0.1

# --- Domínios Públicos (Aponte registros DNS Tipo A para o IP da sua VPS) ---
ACME_EMAIL=infra@seudominio.com.br
API_DOMAIN=api.seudominio.com.br
CONSOLE_DOMAIN=itam.seudominio.com.br
PORTAL_DOMAIN=portal.seudominio.com.br

# --- URLs injetadas no build dos Frontends (React 19 & Vue 3.5) ---
VITE_API_GATEWAY_URL=https://api.seudominio.com.br
VITE_PORTAL_URL=https://portal.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://itam.seudominio.com.br,https://portal.seudominio.com.br,https://itam-nexus.web.app

# --- Banco de Dados PostgreSQL 16 (Isolado na rede privada nexus-mesh) ---
POSTGRES_USER=nexus_prod
POSTGRES_DB=nexus_itam
POSTGRES_PASSWORD=SUBSTITUA_COM_OPENSSL_RAND_HEX_24

# --- Segredos Criptográficos Zero-Trust (Gere com `openssl rand -hex 32`) ---
NEXUS_JWT_SECRET=SUBSTITUA_COM_OPENSSL_RAND_HEX_32
NEXUS_INTERNAL_SECRET=SUBSTITUA_COM_OPENSSL_RAND_HEX_32
NEXUS_COMPLIANCE_SECRET=SUBSTITUA_COM_OPENSSL_RAND_HEX_32

# --- (Opcional) Variáveis Híbridas Firebase p/ Console React ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
