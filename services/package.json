{
  "name": "@nexus-itam/microservices",
  "version": "3.0.0",
  "private": true,
  "description": "Camada de Microsserviços Fastify, API Gateway, WebSocket NexusDesk e Persistência PostgreSQL do Nexus ITAM",
  "type": "module",
  "scripts": {
    "start:gateway": "node api-gateway/src/server.js",
    "start:assets": "node service-assets/src/server.js",
    "start:tickets": "node service-tickets/src/server.js",
    "start:compliance": "node service-compliance/src/server.js",
    "start:nexusdesk": "node service-nexusdesk/src/server.js",
    "start:all": "node orchestrator.js",
    "test": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
